  "verdict": "No open findings in the corrected HUD tooltip ABI or sail graphic DWORD stores.",
  "findingsFixed": [
    {
      "address": "0x4640e0",
      "cause": "Recovered source dropped one native cdecl parameter, leaving a fictitious undefined unaff_retaddr; all three recovered callers also omitted normal tooltip X.",
      "fix": "Restore CDC, vertical offset, left, and normalX in the source signature and all three calls. Native stack loads and 16-byte caller cleanup prove the layout."
    },
    {
      "address": "0x482ae0",
      "cause": "Five recovered CONCAT44 assignments attempted to interpret temporary integer POINT high words as floating values. Negative Y can give a nonfinite bit pattern.",
      "fix": "Restore the five original DWORD-only writes. Original MOV32 evidence and all later low-word uses independently reviewed."
    }
  ],
  "validation": {
    "nativeCases": 62,
    "javascriptNativeComparisons": 204,
    "focusedTests": 10,
    "strictUndefinedArgumentChecks": 2,
    "coverage": [
      "36 native tooltip cases, four routes: public, dependency, owned Number, retained byte frame. Help 0/1/2; theme 0/1; width 699/700/1024; positive and negative height and vertical offset.",
      "18 full HUD native cases, original and Number routes. Clock -71, 20 boats, speed 1 with divisor 2919. Ahead/faster/slower hovers exercise all three native calls; faster/slower clicks verify speed, divisor and consumed click.",
      "8 sail graphic native cases, original/Number/byte frame routes; horizons -200/-1/0/200, speeds 10/12 and real negative MoveTo coordinates.",
      "Every native comparison includes complete mutable image SHA/bytes, ordered GDI, original RNG and sound requests.",
      "Six new gzip archives restored atomically in a temporary root; canonical bytes compared, then a second restore verified all six existing paths."
    ],
    "limitations": "Finite original-native fixture coverage; actual browser interaction coverage is recorded separately by tools/check-2010-hud-browser.js."
  },
